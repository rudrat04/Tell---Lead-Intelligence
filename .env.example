DATABASE_URL=            # Neon connection string
ANTHROPIC_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
HAIKU_DAILY_CAP_USD=1
# Config pack: private R2 prefix in production; local folder in development (default packs/example-gtm)
TELL_PACK_R2_PREFIX=
TELL_PACK_DIR=
# Digest (Gmail API, send-only): OAuth "Desktop app" client + refresh token from `pnpm gmail:auth`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# People search (Exa people index, free $10/month): names for personas beyond founders
EXA_API_KEY=

# Web search source (Serper, 2,500 free searches): public posts asking for help; capped by pack sources.web_search.per_day
SERPER_API_KEY=

# JSearch on RapidAPI (free Basic plan, 200 requests/month): LinkedIn/Naukri/Indeed listings, pack sources.jsearch
RAPIDAPI_KEY=

# PageSpeed Insights API (free key from Google Cloud): weekly mobile speed check -> site_health_poor; PAGESPEED_PER_RUN caps it (40)
PAGESPEED_API_KEY=
