DATABASE_URL=            # Neon connection string
ANTHROPIC_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
HAIKU_DAILY_CAP_USD=0.06
# Sonnet writer (analyst: opener, email and LinkedIn drafts): own daily cap, effort low|medium
WRITER_DAILY_CAP_USD=0.08
ANALYST_EFFORT=low
# Air Waterfall (your own lookup + email waterfall service): finds a contact for leads with nobody known, and verifies
# emails. Off when either is empty. Caps per digest: AIR_WATERFALL_MAX_LOOKUPS (10), AIR_WATERFALL_MAX_ENRICH (15).
AIR_WATERFALL_URL=https://enrich.f1rstword.com
AIR_WATERFALL_API_KEY=
# Config pack: private R2 prefix in production; local folder in development (default packs/example-gtm)
TELL_PACK_R2_PREFIX=
TELL_PACK_DIR=
# Digest (Gmail API, send-only): OAuth "Desktop app" client + refresh token from `pnpm gmail:auth`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# People search (Exa people index, free $10/month): names for personas beyond founders
EXA_API_KEY=

# Web search source (Serper, 2,500 free searches): public posts asking for help; capped by pack sources.web_search.per_day
SERPER_API_KEY=

# JSearch (200 free requests/month): LinkedIn/Naukri/Indeed listings, pack sources.jsearch. JSEARCH_API_KEY = an
# OpenWeb Ninja key (ak_..., used first); RAPIDAPI_KEY = the RapidAPI route to the same data
JSEARCH_API_KEY=
RAPIDAPI_KEY=

# PageSpeed Insights API (free key from Google Cloud): weekly mobile speed check -> site_health_poor; PAGESPEED_PER_RUN caps it (40)
PAGESPEED_API_KEY=

# Niche public records (pnpm niche): openFDA, USASpending and CMS need no key. An openFDA key (free, api.data.gov signup:
# https://open.fda.gov/apis/authentication/) raises the limit from 1,000 to 120,000 requests a day.
OPENFDA_API_KEY=
# Not used by code yet (free keys worth having for the next sources): SAM.gov opportunities API (free with a SAM.gov
# account: Account Details -> API Key) for open federal solicitations; data.gov.in API key (free signup) for Indian
# government datasets.
SAM_API_KEY=
DATA_GOV_IN_API_KEY=
# SEC Form D by industry (pnpm niche formd): SEC asks automated clients to name themselves with a contact email,
# e.g. "Your Name you@example.com". Without it Form D discovery is skipped.
SEC_USER_AGENT=
# Socrata open-data portals (city permits, FMCSA census): optional app token, raises the throttle
SOCRATA_APP_TOKEN=

# Company resolution and email APIs (all optional; each step is skipped without its key)
BRANDFETCH_SEARCH_API=          # Brandfetch Brand Search client id (free, 500k requests/month)
DIFFBOT_TOKEN=                  # Diffbot Knowledge Graph (10,000 free credits/month = 400 organisations)
DIFFBOT_PER_DAY=6               # organisations a day for niche names
DIFFBOT_FACTS_PER_DAY=6         # organisations a day for company facts
QUICKEMAILVERIFICATION_API_KEY= # 100 free verifications a day
QEV_PER_DAY=90
HUNTER_API_KEY=                 # 50 free credits a month
HUNTER_PER_MONTH=45
PROSPEO_API_KEY=                # ~75 free a month
PROSPEO_PER_MONTH=40

# Firecrawl (rendered page text for sites built in JavaScript, used by the proof-of-fit check; each render = 1 credit)
FIRECRAWL_API_KEY=
FIRECRAWL_PER_DAY=10
# Proof-of-fit (Haiku) daily cap and checks per run
FIT_DAILY_CAP_USD=0.03
FIT_CHECKS_PER_RUN=30
